# ===========================================
# Company Brain - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---- LLM API Keys ----
GROQ_API_KEY=                     # Groq API key (https://console.groq.com)
GOOGLE_API_KEY=                   # Gemini API key (https://aistudio.google.com)
MISTRAL_API_KEY=                  # Mistral API key (https://console.mistral.ai)

# ---- Telnyx WhatsApp ----
TELYNX_API_KEY=                   # Telnyx API key (https://portal.telnyx.com)
TELYNX_NUMBER=                    # Business WhatsApp number (+1xxxxxxxxxx)
OWNER_NUMBER=                     # Owner's personal WhatsApp number (+1xxxxxxxxxx)

# ---- Database (local dev) ----
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/companybrain

# ---- Gmail (Week 2+) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- AgentOS ----
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=8000
